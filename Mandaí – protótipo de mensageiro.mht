@charset "utf-8";

:root { --bg: #f3f7ff; --panel: #fff; --ink: #0f1b3d; --mute: #6b7a99; --line: #e3eaf7; --out: #2b7cf6; --outink: #fff; --in: #fff; --chip: #e6f0ff; --ok: #22b573; --hl: #ffb347; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --bg: #0a0e18; --panel: #0f1524; --ink: #e9eef8; --mute: #8794ad; --line: #1b2438; --out: #2f7df6; --outink: #fff; --in: #161e31; --chip: #152447; }
}

:root[data-theme="dark"] { --bg: #0a0e18; --panel: #0f1524; --ink: #e9eef8; --mute: #8794ad; --line: #1b2438; --out: #2f7df6; --outink: #fff; --in: #161e31; --chip: #152447; }

* { box-sizing: border-box; margin: 0px; }

:root { padding-top: env(safe-area-inset-top,0px); padding-bottom: env(safe-area-inset-bottom,0px); }

html { scroll-padding-top: env(safe-area-inset-top,0px); }

html, body { height: 100%; }

body { font-family: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--ink); overflow: hidden; }

button { font: inherit; color: inherit; background: none; border: 0px; cursor: pointer; }

button:focus-visible, input:focus-visible { outline: 2px solid var(--out); outline-offset: 2px; }

.app { height: 100%; display: flex; max-width: 1100px; margin: 0px auto; background: var(--panel); }

.side { width: 100%; display: flex; flex-direction: column; border-right: 1px solid var(--line); min-height: 0px; }

.main { display: none; flex: 1 1 0%; flex-direction: column; min-width: 0px; min-height: 0px; background: var(--bg); }

.app.open .side { display: none; }

.app.open .main { display: flex; }

@media (min-width: 760px) {
  .side { width: 340px; flex: 0 0 auto; }
  .main, .app.open .side { display: flex; }
  .back { display: none; }
}

.top { display: flex; align-items: center; gap: 10px; padding: 14px 16px; }

.top h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; flex: 1 1 0%; }

.ib { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-size: 18px; }

.ib:hover { background: var(--bg); }

.search { margin: 0px 16px 10px; padding: 11px 16px; border-radius: 14px; border: 0px; background: var(--bg); color: var(--ink); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 15px; }

.chips { display: flex; gap: 8px; padding: 0px 16px 10px; }

.chip { padding: 6px 14px; border-radius: 16px; background: var(--bg); color: var(--mute); font-size: 14px; font-weight: 600; }

.chip.on { background: var(--chip); color: var(--out); }

.list { overflow-y: auto; flex: 1 1 0%; min-height: 0px; }

.row { display: flex; gap: 12px; align-items: center; width: 100%; padding: 12px 16px; text-align: left; }

.row:hover, .row.on { background: var(--bg); }

.row.on { box-shadow: inset 3px 0 0 var(--out); }

.av { width: 46px; height: 46px; border-radius: 16px; display: grid; place-items: center; font-weight: 700; color: rgb(255, 255, 255); flex: 0 0 auto; position: relative; }

.av.online::after { content: ""; position: absolute; right: -2px; bottom: -2px; width: 12px; height: 12px; border-radius: 50%; background: var(--ok); border: 2px solid var(--panel); }

.meta { flex: 1 1 0%; min-width: 0px; }

.meta b { display: block; font-weight: 600; font-size: 16px; }

.meta span { display: block; color: var(--mute); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.when { text-align: right; font-size: 12px; color: var(--mute); display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }

.badge { background: var(--out); color: rgb(255, 255, 255); border-radius: 10px; min-width: 20px; padding: 1px 6px; font-size: 12px; font-weight: 600; text-align: center; }

.head { display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }

.head .av { width: 40px; height: 40px; border-radius: 14px; }

.head .meta b { font-size: 16px; }

.msgs { flex: 1 1 0%; overflow-y: auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 4px; min-height: 0px; background-image: radial-gradient(color-mix(in srgb,var(--ink) 9%,transparent) 1px,transparent 1.6px); background-size: 22px 22px; }

.day { align-self: center; background: var(--chip); color: var(--mute); font-size: 12px; padding: 3px 12px; border-radius: 10px; margin: 6px 0px; }

.m { max-width: 78%; padding: 8px 12px 6px; border-radius: 18px; font-size: 15.5px; line-height: 1.4; overflow-wrap: break-word; white-space: pre-wrap; }

.m { box-shadow: 0 1px 2px color-mix(in srgb,var(--ink) 12%,transparent); }

.m.in { align-self: flex-start; background: var(--in); border-bottom-left-radius: 6px; }

.m.in + .m.in { border-top-left-radius: 6px; }

.m.out + .m.out { border-top-right-radius: 6px; }

.m.out { align-self: flex-end; background: linear-gradient(135deg,var(--out),color-mix(in srgb,var(--out) 68%,#e0577a)); color: var(--outink); border-bottom-right-radius: 6px; }

.m small { display: block; text-align: right; font-size: 11px; opacity: 0.7; margin-top: 2px; }

.m.new { animation: 0.18s ease-out 0s 1 normal none running pop; }

@keyframes pop { 
  0% { transform: scale(0.96); opacity: 0.4; }
}

.typing { align-self: flex-start; background: var(--in); padding: 10px 14px; border-radius: 18px 18px 18px 6px; display: flex; gap: 4px; }

.typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--mute); animation: 1s ease 0s infinite normal none running b; }

.typing i:nth-child(2) { animation-delay: 0.15s; }

.typing i:nth-child(3) { animation-delay: 0.3s; }

@keyframes b { 
  40% { transform: translateY(-4px); }
}

.compose { display: flex; gap: 8px; padding: 8px 12px 12px; background: transparent; }

.compose input { flex: 1 1 0%; padding: 13px 18px; border-radius: 24px; border: 0px; background: var(--panel); color: var(--ink); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 16px; min-width: 0px; box-shadow: 0 2px 8px color-mix(in srgb,var(--ink) 10%,transparent); }

.send { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg,var(--out),color-mix(in srgb,var(--out) 68%,#e0577a)); color: rgb(255, 255, 255); flex: 0 0 auto; display: grid; place-items: center; box-shadow: 0 4px 12px color-mix(in srgb,var(--out) 40%,transparent); }

.send:active { transform: scale(0.94); }

.empty { margin: auto; color: var(--mute); text-align: center; padding: 20px; }

.main { position: relative; }

.msgs { background-color: color-mix(in srgb,var(--out) 7%,var(--bg)); }

.m.in { cursor: pointer; }

.sheet { position: absolute; left: 0px; right: 0px; bottom: 0px; background: var(--panel); border-radius: 22px 22px 0px 0px; padding: 18px 18px calc(18px + env(safe-area-inset-bottom,0px)); box-shadow: rgba(0, 0, 0, 0.25) 0px -8px 30px; z-index: 5; animation: 0.2s ease-out 0s 1 normal none running up; }

.sheet[hidden] { display: none; }

@keyframes up { 
  0% { transform: translateY(30px); opacity: 0; }
}

.sheet h3 { font-size: 17px; margin-bottom: 10px; }

.sheet p { font-size: 15px; line-height: 1.5; margin-bottom: 8px; }

.opt { display: block; width: 100%; text-align: left; padding: 13px 14px; border-radius: 12px; background: var(--bg); margin-bottom: 8px; font-weight: 600; }

.sw { display: flex; gap: 12px; margin: 8px 0px 14px; }

.sw button { width: 40px; height: 40px; border-radius: 50%; border: 3px solid transparent; }

.sw button.on { border-color: var(--ink); }

.later { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--chip); font-size: 14px; }

.later b { flex: 1 1 0%; font-weight: 600; }

.later button { color: var(--out); font-weight: 700; }

.stories { display: flex; gap: 14px; padding: 0px 16px 12px; overflow-x: auto; flex: 0 0 auto; }

.st { display: flex; flex-direction: column; align-items: center; gap: 5px; flex: 0 0 auto; width: 62px; }

.st small { font-size: 12px; color: var(--mute); max-width: 62px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ring { padding: 3px; border-radius: 50%; display: block; }

.ring .av { width: 52px; height: 52px; border-radius: 50%; border: 3px solid var(--panel); }

.viewer { position: fixed; inset: 0px; max-width: 480px; margin: 0px auto; z-index: 20; display: flex; flex-direction: column; color: rgb(255, 255, 255); padding: env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px); }

.viewer[hidden] { display: none; }

.bars { display: flex; gap: 4px; padding: 12px 12px 0px; }

.bar { flex: 1 1 0%; height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }

.bar i { display: block; height: 100%; background: rgb(255, 255, 255); }

@keyframes fill { 
  0% { width: 0px; }
  100% { width: 100%; }
}

.vh { display: flex; align-items: center; gap: 10px; padding: 12px; position: relative; z-index: 2; }

.vh .av { width: 38px; height: 38px; border-radius: 50%; font-size: 13px; background: rgba(255, 255, 255, 0.25); }

.vh small { opacity: 0.85; }

.x { color: rgb(255, 255, 255); font-size: 22px; width: 40px; height: 40px; }

.vt { flex: 1 1 0%; display: grid; place-items: center; text-align: center; padding: 24px; font-size: 28px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; text-wrap: balance; }

.zl, .zr { position: absolute; top: 80px; bottom: 0px; background: none; }

.zl { left: 0px; width: 40%; }

.zr { right: 0px; width: 60%; }

.ct { flex: 1 1 0%; background: transparent; border: 0px; color: rgb(255, 255, 255); font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 28px; font-weight: 700; text-align: center; resize: none; padding: 24px; outline: none; }

.ct::placeholder { color: rgba(255, 255, 255, 0.6); }

.viewer .sw { justify-content: center; }

.viewer .sw button.on { border-color: rgb(255, 255, 255); }

.pub { margin: 12px; padding: 14px; border-radius: 14px; background: rgb(255, 255, 255); color: rgb(22, 24, 43); font-weight: 700; }

.eye { position: relative; z-index: 2; margin: 0px auto 12px; padding: 10px 18px; border-radius: 20px; background: rgba(0, 0, 0, 0.35); color: rgb(255, 255, 255); font-weight: 600; }

.vp { position: absolute; left: 0px; right: 0px; bottom: 0px; z-index: 3; background: var(--panel); color: var(--ink); border-radius: 22px 22px 0px 0px; padding: 18px 18px calc(18px + env(safe-area-inset-bottom,0px)); max-height: 60%; overflow-y: auto; }

.vp h3 { font-size: 17px; margin-bottom: 10px; }

.vr { display: flex; align-items: center; gap: 12px; padding: 8px 0px; }

.vr .av { width: 40px; height: 40px; border-radius: 50%; font-size: 14px; }

.vr b { flex: 1 1 0%; font-weight: 600; }

.vr small { color: var(--mute); }

.viewer.paused .bar i { animation-play-state: paused !important; }

.me { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: grid; place-items: center; font-weight: 700; font-size: 14px; color: rgb(255, 255, 255); }

.head .meta, .head .av { cursor: pointer; }

