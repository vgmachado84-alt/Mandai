.klsb { position: absolute; left: 0px; bottom: 0px; height: 3px; width: 100%; background: linear-gradient(90deg, rgb(255, 107, 111), rgb(229, 72, 77)); transform-origin: left center; animation: 6.5s linear 0s 1 normal both running subar; }

@keyframes subar { 
  0% { transform: scaleX(1); }
  100% { transform: scaleX(0); }
}

.m.sys.modmsg { display: flex; align-items: center; gap: 10px; text-align: left; max-width: 86%; padding: 10px 14px 10px 10px; border-radius: 16px; font-weight: 400; }

.m.sys.modmsg .sci { width: 34px; height: 34px; border-radius: 50%; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: rgb(255, 255, 255); }

.m.sys.modmsg.bad .sci { background: linear-gradient(145deg, rgb(255, 107, 111), rgb(229, 72, 77)); }

.m.sys.modmsg.ok .sci { background: linear-gradient(145deg, rgb(62, 213, 152), rgb(34, 181, 115)); }

.m.sys.modmsg .scw { display: flex; flex-direction: column; }

.m.sys.modmsg b { font-size: 13.5px; font-weight: 700; }

.m.sys.modmsg small { font-size: 12px; opacity: 0.8; color: inherit; }

.blk.susb { display: flex; align-items: center; gap: 12px; justify-content: flex-start; padding: 10px 16px calc(10px + env(safe-area-inset-bottom,0px)); background: color-mix(in srgb,#e5484d 11%,var(--panel)); border-top: 1px solid color-mix(in srgb,#e5484d 30%,var(--line)); color: var(--ink); }

.blk.susb .sbi { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: rgb(255, 255, 255); background: linear-gradient(145deg, rgb(255, 107, 111), rgb(229, 72, 77)); }

.sbt { display: flex; flex-direction: column; text-align: left; }

.sbt b { font-size: 14.5px; color: rgb(229, 72, 77); }

.sbt small { font-size: 12.5px; color: var(--mute); }

.klsu { z-index: 35; }

.m.sys.modmsg small { align-self: flex-start; text-align: left; float: none; margin: 0px; }

.klsu { display: none !important; }

.m.sys.modmsg { display: inline-flex; align-items: center; gap: 6px; max-width: 92%; padding: 4px 11px 4px 8px; border-radius: 14px; font-size: 12px; font-weight: 500; line-height: 1.3; text-align: left; border: 0px; }

.m.sys.modmsg .sci { width: auto; height: auto; display: flex; flex: 0 0 auto; color: inherit; background: none !important; }

.m.sys.modmsg.bad { background: color-mix(in srgb,#e5484d 12%,var(--chip)); color: rgb(229, 72, 77); }

.m.sys.modmsg.ok { background: color-mix(in srgb,#22b573 12%,var(--chip)); color: rgb(34, 160, 107); }

.m.sys.modmsg .scw { font-size: 12px; font-weight: 500; }

.blk.susb { gap: 8px; justify-content: center; padding: 8px 14px calc(8px + env(safe-area-inset-bottom,0px)); background: var(--panel); }

.blk.susb .sbi { width: auto; height: auto; background: none; color: rgb(229, 72, 77); }

.blk.susb .sbt { flex-flow: wrap; align-items: center; gap: 6px; justify-content: center; }

.blk.susb .sbt b { font-size: 13px; }

.blk.susb .sbt small { font-size: 12.5px; }

.pane#pc .stories { max-height: 170px; transition: max-height 0.26s, opacity 0.2s, padding 0.26s; }

.pane#pc.scol .stories { max-height: 0px; opacity: 0; padding-top: 0px; padding-bottom: 0px; border-bottom-width: 0px; overflow: hidden; pointer-events: none; }

.m, .m * { user-select: none; }

.m { touch-action: pan-y; }

.pane#pc .chips { max-height: 64px; transition: max-height 0.26s, opacity 0.2s, padding 0.26s, margin 0.26s; }

.pane#pc.scol .chips { max-height: 0px; opacity: 0; padding-top: 0px; padding-bottom: 0px; margin-top: 0px; margin-bottom: 0px; overflow: hidden; pointer-events: none; }

.setv.vv { bottom: auto; height: var(--vvh,100%); overflow-y: auto; }

.ngbody { padding: 6px 0 calc(40px + env(safe-area-inset-bottom,0px)); }

.ngphw { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 6px 0px 14px; }

.ngphw small { color: var(--out); font-weight: 600; font-size: 13.5px; }

.ngph { position: relative; width: 104px; height: 104px; border-radius: 50%; border: 0px; color: rgb(255, 255, 255); background: linear-gradient(145deg, rgb(106, 99, 245), rgb(74, 67, 214)); display: flex; align-items: center; justify-content: center; box-shadow: rgba(74, 67, 214, 0.35) 0px 8px 22px; }

.ngcm { position: absolute; right: 0px; bottom: 2px; width: 32px; height: 32px; border-radius: 50%; background: var(--out); border: 3px solid var(--bg); display: flex; align-items: center; justify-content: center; font-style: normal; }

.ngc { padding: 4px 0px; }

.ngf { display: block; position: relative; margin: 0px 14px; border-bottom: 1px solid var(--line); }

.ngf:last-child { border-bottom: 0px; }

.ngf input, .ngf textarea { width: 100%; box-sizing: border-box; border: 0px; background: transparent; color: var(--ink); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 16px; padding: 15px 44px 15px 2px; outline: 0px; resize: none; }

.ngn { position: absolute; right: 2px; top: 50%; transform: translateY(-50%); color: var(--mute); font-size: 12px; }

.ngs { display: flex; gap: 14px; overflow-x: auto; padding: 4px 16px 12px; scrollbar-width: none; }

.ngs::-webkit-scrollbar { display: none; }

.ngm { flex: 0 0 auto; width: 58px; display: flex; flex-direction: column; align-items: center; gap: 5px; }

.ngm .av { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: rgb(255, 255, 255); font-weight: 700; font-size: 16px; }

.ngm small { font-size: 12px; color: var(--mute); max-width: 58px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.ngd { padding: 14px; }

.ngdh { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 12px; }

.ngdi { width: 36px; height: 36px; border-radius: 50%; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb,var(--out) 16%,transparent); color: var(--out); }

.ngdt { display: flex; flex-direction: column; }

.ngdt b { font-size: 15px; }

.ngdt small { color: var(--mute); font-size: 12.5px; line-height: 1.4; margin-top: 2px; }

.ngseg { display: flex; padding: 4px; border-radius: 14px; background: color-mix(in srgb,var(--ink) 8%,var(--bg)); gap: 4px; }

.ngseg button { flex: 1 1 0%; border: 0px; border-radius: 11px; background: transparent; color: var(--mute); font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 14px; font-weight: 600; padding: 10px 4px; transition: background 0.18s, color 0.18s; }

.ngseg button.on { background: var(--out); color: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.2) 0px 3px 10px; }

.ngcreate { display: block; width: calc(100% - 28px); margin: 20px 14px 0px; }

.ngcreate.dis, .amgo.dis { opacity: 0.45; }

.amgo:disabled { box-shadow: none; }

.cdest.lock { pointer-events: none; }

.ced::before { display: none; }

#stp { background-image: none; }

